<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty gameDetails.screenshots}"><section class="panel game-gallery" aria-labelledby="gallery-title" data-game-gallery>
    <div class="section-heading"><div><span class="eyebrow">A WINDOW INTO THIS LITTLE WORLD</span><h2 id="gallery-title">ゲームギャラリー</h2></div><p class="gallery-counter" data-gallery-counter role="status" aria-live="polite">1 / ${fn:length(gameDetails.screenshots)}</p></div>
    <div class="gallery-stage"><img data-gallery-main width="1536" height="864" src="${pageContext.request.contextPath}/<c:out value='${gameDetails.screenshots[0]}' />" alt="<c:out value='${game.title}' /> のギャラリー画像 1"><p class="gallery-load-error" data-gallery-error role="alert" hidden>画像を読み込めませんでした。ほかの画像を選んでください。</p></div>
    <nav class="gallery-thumbs" aria-label="ギャラリー画像を選ぶ"><c:forEach var="shot" items="${gameDetails.screenshots}" varStatus="status"><a data-gallery-thumb href="${pageContext.request.contextPath}/<c:out value='${shot}' />" target="_blank" rel="noopener" aria-label="画像 ${status.count} を表示" aria-current="${status.first ? 'true' : 'false'}"><img width="320" height="180" loading="lazy" src="${pageContext.request.contextPath}/<c:out value='${shot}' />" alt="<c:out value='${game.title}' /> のギャラリー画像 ${status.count}"></a></c:forEach></nav>
    <div class="gallery-footer"><c:if test="${not empty gameDetails.galleryNote}"><p class="gallery-note"><c:out value="${gameDetails.galleryNote}" /></p></c:if><a class="section-link" data-gallery-open href="${pageContext.request.contextPath}/<c:out value='${gameDetails.screenshots[0]}' />" target="_blank" rel="noopener">画像を別タブで開く ↗</a></div>
</section></c:if>
