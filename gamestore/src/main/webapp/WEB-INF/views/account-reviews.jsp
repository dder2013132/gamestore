<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="ja"><head><%@ include file="/WEB-INF/jspf/head.jspf" %><title>自分のレビュー - PLAYPORT</title></head><body>
<c:set var="navSection" value="account" /><%@ include file="/WEB-INF/jspf/header.jspf" %>
<main class="my-reviews-page" id="reviews"><div class="page-heading admin-heading"><div><span class="eyebrow">WORDS YOU HAVE LEFT BEHIND</span><h1>自分のレビュー</h1><p>ゲームと出会って、書き留めたこと。</p></div><a class="button button-secondary button-small" href="${pageContext.request.contextPath}/account">マイページへ</a></div>
<c:if test="${param.deleted == '1'}"><p class="auth-success" role="status">レビューを削除しました。</p></c:if>
<c:choose><c:when test="${not empty reviewError}"><p class="auth-error" role="alert"><c:out value="${reviewError}" /></p><a class="button button-secondary" href="${pageContext.request.contextPath}/account/reviews">もう一度読み込む</a></c:when>
<c:when test="${empty reviews.entries}"><div class="empty-state"><span class="empty-symbol" aria-hidden="true">☆</span><h2>まだ、レビューはありません。</h2><p>注文が完了したゲームのページから、感想を残せます。</p><a class="button button-secondary" href="${pageContext.request.contextPath}/orders">注文履歴を見る</a></div></c:when>
<c:otherwise><div class="review-list"><c:forEach var="review" items="${reviews.entries}"><article class="panel review-card"><a class="review-game" href="${pageContext.request.contextPath}/games?id=${review.gameId}#reviews"><img width="64" height="64" src="${pageContext.request.contextPath}/<c:out value='${review.imagePath}' />" alt=""><div><h2><c:out value="${review.gameTitle}" /></h2><span class="review-stars" aria-label="5点満点中${review.rating}点"><c:out value="${review.stars}" /></span></div></a>
    <p class="review-date"><c:out value="${review.formattedCreatedAt}" /><c:if test="${review.edited}"> · 編集済み <c:out value="${review.formattedUpdatedAt}" /></c:if></p><div class="review-body"><c:out value="${review.body}" /></div>
    <div class="review-manage"><a class="button button-secondary button-small" href="${pageContext.request.contextPath}/reviews/edit?gameId=${review.gameId}">レビューを編集</a>
        <details class="review-delete"><summary>このレビューを削除</summary><p>このレビューを削除します。続ける場合は確定してください。</p><form action="${pageContext.request.contextPath}/reviews/delete" method="post" data-review-form><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="gameId" value="${review.gameId}"><input type="hidden" name="reviewId" value="${review.id}"><input type="hidden" name="version" value="${review.version}"><button class="button button-secondary button-small" type="submit">レビューの削除を確定する</button></form></details>
    </div></article></c:forEach></div><%@ include file="/WEB-INF/jspf/review-pagination.jspf" %></c:otherwise></c:choose>
</main><%@ include file="/WEB-INF/jspf/footer.jspf" %></body></html>
