<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="ja"><head><%@ include file="/WEB-INF/jspf/head.jspf" %><title>ダッシュボード - PLAYPORT</title></head><body>
<c:set var="navSection" value="adminDashboard" /><%@ include file="/WEB-INF/jspf/header.jspf" %>
<main class="dashboard-page">
<div class="page-heading admin-heading"><div><span class="eyebrow">A LITTLE LOOK BEHIND THE SHELF</span><h1>ストアのダッシュボード</h1><p>注文とゲームの動きを、ひと目で。</p></div><span class="admin-label">ADMIN ONLY</span></div>
<%@ include file="/WEB-INF/jspf/admin-nav.jspf" %>
<section class="panel dashboard-filter" aria-label="集計期間">
<form method="get" action="${pageContext.request.contextPath}/admin/dashboard"><div><label for="dashboard-from">注文受付日・開始</label><input id="dashboard-from" name="from" type="date" min="0001-01-01" max="9999-12-31" value="<c:out value='${fromDate}' />"></div><div><label for="dashboard-to">注文受付日・終了</label><input id="dashboard-to" name="to" type="date" min="0001-01-01" max="9999-12-31" value="<c:out value='${toDate}' />"></div><button class="button" type="submit">集計する</button><a class="section-link" href="${pageContext.request.contextPath}/admin/dashboard">全期間に戻す</a></form>
<c:url var="last30Url" value="/admin/dashboard"><c:param name="from" value="${last30Date}" /><c:param name="to" value="${todayDate}" /></c:url>
<div class="dashboard-period-help"><p>注文受付日を基準に、期間内の注文の現在の状態を集計します。開始日・終了日も含みます。</p><a class="filter-chip" href="<c:out value='${last30Url}' />">直近30日を見る</a></div>
</section>
<p class="demo-payment-notice"><strong>テスト決済の集計</strong> 完了注文の金額です。実際の入金・売上ではありません。</p>
<c:choose><c:when test="${not empty dashboardError}"><p class="auth-error" role="alert"><c:out value="${dashboardError}" /></p><a class="button button-secondary" href="${pageContext.request.contextPath}/admin/dashboard">集計をやり直す</a></c:when><c:otherwise>
<c:set var="stats" value="${dashboard.summary}" />
<div class="dashboard-stats" aria-label="完了注文の集計">
<div class="panel dashboard-stat is-highlight"><span>完了注文金額</span><strong>¥<fmt:formatNumber value="${stats.completedAmount}" pattern="#,##0" /></strong><small>支払い待ち・キャンセルは含みません。</small></div>
<div class="panel dashboard-stat"><span>完了した注文</span><strong><fmt:formatNumber value="${stats.completedCount}" pattern="#,##0" /><small> 件</small></strong><small>注文単位で数えます。</small></div>
<div class="panel dashboard-stat"><span>販売したゲーム</span><strong><fmt:formatNumber value="${stats.soldUnits}" pattern="#,##0" /><small> 本</small></strong><small>完了注文に含まれる商品数。</small></div>
<div class="panel dashboard-stat"><span>購入した会員</span><strong><fmt:formatNumber value="${stats.buyerCount}" pattern="#,##0" /><small> 人</small></strong><small>同じ会員は1人と数えます。</small></div>
</div>
<c:if test="${stats.completedCount == 0}"><p class="dashboard-empty-note">この期間に受け付けた注文で、完了したものはまだありません。ゲーム別の一覧には販売数0本のゲームも表示します。</p></c:if>
<div class="dashboard-middle">
<section class="panel dashboard-trend" aria-labelledby="daily-sales-title"><span class="eyebrow">LITTLE STEPS, DAY BY DAY</span><h2 id="daily-sales-title">日ごとの完了注文金額</h2><p class="dashboard-chart-range"><c:out value="${dashboard.chartFrom}" /> 〜 <c:out value="${dashboard.chartTo}" /> · 対象期間の直近${fn:length(dashboard.days)}日</p>
<c:if test="${dashboard.peakAmount == 0}"><p class="dashboard-zero-trend">この表示期間の完了注文金額は0円です。注文の件数は下の表でも確認できます。</p></c:if>
<div class="dashboard-chart-scroll"><ol class="dashboard-chart" style="--days:${fn:length(dashboard.days)}" aria-label="注文受付日ごとの完了注文金額"><c:forEach var="day" items="${dashboard.days}"><li><span class="sr-only"><c:out value="${day.date}" />：${day.orderCount}件、¥<fmt:formatNumber value="${day.amount}" pattern="#,##0" /></span><div class="dashboard-bar-track" aria-hidden="true" title="${day.date} · ${day.orderCount}件 · ¥<fmt:formatNumber value='${day.amount}' pattern='#,##0' />"><span style="height:${day.percent}%"></span></div><span class="dashboard-bar-date" aria-hidden="true">${day.dateLabel}</span></li></c:forEach></ol></div>
<p class="dashboard-chart-hint">横にスクロールして全日付を確認できます。</p>
<details class="dashboard-daily-details"><summary>日別の件数・金額を表で見る</summary><table class="dashboard-daily-table"><caption class="sr-only">日別の完了注文</caption><thead><tr><th>注文受付日</th><th>完了注文</th><th>完了注文金額</th></tr></thead><tbody><c:forEach var="day" items="${dashboard.days}"><tr><td>${day.date}</td><td>${day.orderCount} 件</td><td>¥<fmt:formatNumber value="${day.amount}" pattern="#,##0" /></td></tr></c:forEach></tbody></table></details>
</section>
<aside class="panel dashboard-status" aria-labelledby="dashboard-status-title"><span class="eyebrow">EVERY ORDER HAS A CHAPTER</span><h2 id="dashboard-status-title">注文の状態</h2><p class="dashboard-status-help">選ぶと、同じ期間・状態の注文一覧へ移動します。</p>
<c:forEach var="state" items="${orderStatuses}"><c:choose><c:when test="${state.code == 'PENDING'}"><c:set var="stateCount" value="${stats.pendingCount}" /><c:set var="stateAmount" value="${stats.pendingAmount}" /></c:when><c:when test="${state.code == 'CANCELLED'}"><c:set var="stateCount" value="${stats.cancelledCount}" /><c:set var="stateAmount" value="${stats.cancelledAmount}" /></c:when><c:otherwise><c:set var="stateCount" value="${stats.completedCount}" /><c:set var="stateAmount" value="${stats.completedAmount}" /></c:otherwise></c:choose>
<c:url var="statusUrl" value="/admin/orders"><c:param name="from" value="${fromDate}" /><c:param name="to" value="${toDate}" /><c:param name="status" value="${state.code}" /></c:url>
<a class="dashboard-status-row" href="<c:out value='${statusUrl}' />"><span class="order-status is-${state.cssClass}">${state.label}</span><strong><fmt:formatNumber value="${stateCount}" pattern="#,##0" /> 件 <span aria-hidden="true">↗</span></strong><small>¥<fmt:formatNumber value="${stateAmount}" pattern="#,##0" /></small></a>
</c:forEach></aside>
</div>
<section id="game-sales" aria-labelledby="game-sales-title"><div class="section-heading"><div><span class="eyebrow">THE STORIES ON YOUR SHELF</span><h2 id="game-sales-title">ゲーム別の販売状況</h2><p class="dashboard-table-note">完了商品の金額が多い順。販売休止中・販売数0本のゲームも含みます。</p></div><a class="section-link" href="${pageContext.request.contextPath}/admin/games">ゲームを管理 ↗</a></div>
<c:choose><c:when test="${empty dashboard.games}"><div class="empty-state"><span class="empty-symbol" aria-hidden="true">✳</span><h2>棚にゲームを並べよう。</h2><p>ゲームを登録すると、ここで販売状況を確認できます。</p><a class="button" href="${pageContext.request.contextPath}/admin/games">ゲームを登録する</a></div></c:when><c:otherwise>
<div class="panel dashboard-sales-panel"><table class="dashboard-sales-table"><caption class="sr-only">対象期間のゲーム別販売状況</caption><thead><tr><th>ゲーム</th><th>販売本数</th><th>購入した会員</th><th>完了商品金額</th></tr></thead><tbody><c:forEach var="sale" items="${dashboard.games}"><tr><td data-label="ゲーム"><div class="dashboard-game"><img width="52" height="52" loading="lazy" src="${pageContext.request.contextPath}/<c:out value='${sale.game.imagePath}' />" alt=""><div><a href="${pageContext.request.contextPath}/admin/games/edit?id=${sale.game.id}"><c:out value="${sale.game.title}" /></a><span class="sale-status ${sale.game.active ? '' : 'is-paused'}">${sale.game.active ? '販売中' : '販売休止中'}</span></div></div></td><td data-label="販売本数"><fmt:formatNumber value="${sale.units}" pattern="#,##0" /> 本</td><td data-label="購入した会員"><fmt:formatNumber value="${sale.buyers}" pattern="#,##0" /> 人</td><td data-label="完了商品金額"><strong>¥<fmt:formatNumber value="${sale.amount}" pattern="#,##0" /></strong></td></tr></c:forEach></tbody></table></div>
<p class="dashboard-table-note">購入時の商品単価で集計します。上の完了注文金額は注文の総額を基準にしています。</p><p class="catalog-range">${dashboard.gameCount} 件中 ${dashboard.firstResult}–${dashboard.lastResult} 件を表示</p>
<c:if test="${dashboard.pageCount > 1}"><c:url var="dashboardBase" value="/admin/dashboard"><c:param name="from" value="${fromDate}" /><c:param name="to" value="${toDate}" /></c:url><nav class="pagination" aria-label="ゲーム販売状況のページ"><c:choose><c:when test="${dashboard.page > 1}"><a rel="prev" href="<c:out value='${dashboardBase}' />&amp;page=${dashboard.page - 1}#game-sales">← 前へ</a></c:when><c:otherwise><span class="page-step is-disabled" aria-disabled="true">← 前へ</span></c:otherwise></c:choose><div class="page-numbers"><c:forEach var="number" begin="${dashboard.pageStart}" end="${dashboard.pageEnd}"><c:choose><c:when test="${number == dashboard.page}"><span class="is-current" aria-current="page" aria-label="${number}ページ目">${number}</span></c:when><c:otherwise><a href="<c:out value='${dashboardBase}' />&amp;page=${number}#game-sales" aria-label="${number}ページ目">${number}</a></c:otherwise></c:choose></c:forEach></div><c:choose><c:when test="${dashboard.page < dashboard.pageCount}"><a rel="next" href="<c:out value='${dashboardBase}' />&amp;page=${dashboard.page + 1}#game-sales">次へ →</a></c:when><c:otherwise><span class="page-step is-disabled" aria-disabled="true">次へ →</span></c:otherwise></c:choose></nav></c:if>
</c:otherwise></c:choose></section>
</c:otherwise></c:choose>
</main><%@ include file="/WEB-INF/jspf/footer.jspf" %></body></html>
