<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="ja"><head><%@ include file="/WEB-INF/jspf/head.jspf" %><title>ライブラリ - PLAYPORT</title></head><body>
<c:set var="navSection" value="library" /><%@ include file="/WEB-INF/jspf/header.jspf" %>
<main class="library-page"><div class="page-heading library-heading"><div><span class="eyebrow">YOUR LITTLE WORLDS, ALL TOGETHER</span><h1>ライブラリ</h1><p>あなたの棚に並んだゲーム。次は、感想を残してみよう。</p></div><c:if test="${not empty library}"><span class="catalog-total">${library.totalCount} 本のゲーム</span></c:if></div>
<%@ include file="/WEB-INF/jspf/collection-nav.jspf" %>
<div class="library-toolbar"><form class="search-form" method="get" action="${pageContext.request.contextPath}/library"><label class="sr-only" for="library-search">ライブラリ内を検索</label><input id="library-search" name="q" type="search" maxlength="100" placeholder="タイトル・ジャンルで探す…" value="<c:out value='${query}' />"><button type="submit">検索</button></form><a class="section-link" href="${pageContext.request.contextPath}/library">クリア</a><span>取得日の新しい順</span></div>
<c:choose><c:when test="${not empty libraryError}"><p class="auth-error" role="alert"><c:out value="${libraryError}" /></p><a class="button button-secondary" href="${pageContext.request.contextPath}/library">もう一度読み込む</a></c:when>
<c:when test="${empty library.games}"><div class="empty-state"><span class="empty-symbol" aria-hidden="true">✳</span><h2>${empty query ? 'あなたの棚は、これから。' : 'ゲームが見つかりませんでした。'}</h2><p>${empty query ? '注文が完了したゲームがここに並びます。支払い待ちの注文は注文履歴で確認できます。' : 'キーワードを変えるか、検索条件をクリアしてください。'}</p><a class="button button-secondary" href="${pageContext.request.contextPath}/${empty query ? 'browse' : 'library'}">${empty query ? 'ゲームを探す ↗' : '検索条件をクリア'}</a><a class="section-link library-orders-link" href="${pageContext.request.contextPath}/orders">注文履歴を見る</a></div></c:when>
<c:otherwise><div class="game-grid library-grid"><c:forEach var="entry" items="${library.games}"><article class="game-card library-card"><a class="game-card-art" href="${pageContext.request.contextPath}/games?id=${entry.game.id}" aria-label="${fn:escapeXml(entry.game.title)} のゲーム情報を見る"><img width="400" height="400" src="${pageContext.request.contextPath}/<c:out value='${entry.game.imagePath}' />" alt="<c:out value='${entry.game.title}' />" loading="lazy"><span class="library-owned">ライブラリに追加済み</span></a>
    <div class="game-card-body"><span class="genre-label"><c:out value="${entry.game.genre}" /></span><h2><a href="${pageContext.request.contextPath}/games?id=${entry.game.id}"><c:out value="${entry.game.title}" /></a></h2><p class="library-acquired">${entry.formattedAcquiredAt} に取得</p>
        <c:if test="${not entry.game.active}"><span class="sale-status is-paused">ストアでの販売休止中</span></c:if>
        <div class="library-review-state"><c:choose><c:when test="${entry.reviewed}"><span class="review-stars" aria-label="自分の評価は5点満点中${entry.rating}点">★ ${entry.rating}</span><span>レビュー投稿済み</span></c:when><c:otherwise><span>このゲームの感想を残してみよう。</span></c:otherwise></c:choose></div>
        <div class="library-card-actions"><a class="button button-secondary button-small" href="${pageContext.request.contextPath}/games?id=${entry.game.id}">ゲーム情報を見る ↗</a><a class="section-link" href="${pageContext.request.contextPath}/games?id=${entry.game.id}#reviews">${entry.reviewed ? 'レビューを見る・編集 →' : 'レビューを書く →'}</a></div>
    </div></article></c:forEach></div>
    <p class="catalog-range">${library.resultCount} 件中 ${library.firstResult}–${library.lastResult} 件を表示</p>
    <c:if test="${library.pageCount > 1}"><nav class="pagination" aria-label="ライブラリのページ">
        <c:choose><c:when test="${library.page > 1}"><c:url var="libraryPrev" value="/library"><c:param name="q" value="${query}" /><c:param name="page" value="${library.page - 1}" /></c:url><a rel="prev" href="<c:out value='${libraryPrev}' />">← 前へ</a></c:when><c:otherwise><span class="page-step is-disabled" aria-disabled="true">← 前へ</span></c:otherwise></c:choose>
        <div class="page-numbers"><c:forEach var="number" begin="${library.pageStart}" end="${library.pageEnd}"><c:choose><c:when test="${number == library.page}"><span class="is-current" aria-current="page" aria-label="${number}ページ目">${number}</span></c:when><c:otherwise><c:url var="libraryNumber" value="/library"><c:param name="q" value="${query}" /><c:param name="page" value="${number}" /></c:url><a href="<c:out value='${libraryNumber}' />" aria-label="${number}ページ目">${number}</a></c:otherwise></c:choose></c:forEach></div>
        <c:choose><c:when test="${library.page < library.pageCount}"><c:url var="libraryNext" value="/library"><c:param name="q" value="${query}" /><c:param name="page" value="${library.page + 1}" /></c:url><a rel="next" href="<c:out value='${libraryNext}' />">次へ →</a></c:when><c:otherwise><span class="page-step is-disabled" aria-disabled="true">次へ →</span></c:otherwise></c:choose>
    </nav></c:if>
</c:otherwise></c:choose>
</main><%@ include file="/WEB-INF/jspf/footer.jspf" %></body></html>
